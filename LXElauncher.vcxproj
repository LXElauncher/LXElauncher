  <!-- Build 后把 Font Awesome webfonts/ 及其他 vendor 子目录整个复制过去 -->
  <ItemGroup>
    <WebAppVendorFiles Include="$(ProjectDir)webapp\vendor\**\*" Condition="Exists('$(ProjectDir)webapp\vendor')" />
    <WebAppImgFiles Include="$(ProjectDir)webapp\img\**\*" Condition="Exists('$(ProjectDir)webapp\img')" />
  </ItemGroup>
  <Target Name="CopyWebAppVendor" AfterTargets="AfterBuild">
    <Copy SourceFiles="@(WebAppVendorFiles)" DestinationFiles="@(WebAppVendorFiles->'$(TargetDir)webapp\vendor\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WebAppImgFiles)" DestinationFiles="@(WebAppImgFiles->'$(TargetDir)webapp\img\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- 拷贝 aria2c.exe 到输出目录，便于下载使用多线程 -->
    <Copy SourceFiles="$(ProjectDir)tools\aria2c.exe" DestinationFiles="$(TargetDir)aria2c.exe" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)tools\aria2c.exe')" />
    <Message Text="aria2c copied or not found" Importance="high" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
